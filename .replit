run = "node main.js"
entrypoint = "main.js"
modules = ["nodejs-20", "python-3.11", "python3", "postgresql-16"]

[nix]
channel = "stable-22_11"
packages = ["ffmpeg", "freetype", "gh", "git-lfs", "jq", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "nano", "openjpeg", "tcl", "tk", "zlib"]

[deployment]
run = ["node", "main.js"]
deploymentTarget = "vm"
build = ["sh", "-c", "npm install"]
publicDir = "dist/public"

[[ports]]
localPort = 5000
externalPort = 80

[agent]
integrations = ["perplexity_v0:1.0.0", "javascript_websocket:1.0.0", "javascript_stripe:1.0.0", "javascript_openai:1.0.0", "javascript_anthropic:1.0.0", "resend:1.0.0"]

[objectStorage]
defaultBucketID = "replit-objstore-f95b4cf3-0db7-40d1-9680-54f5b997ed65"

[userenv]

[userenv.shared]
NEXT_PUBLIC_REPLIT_SITE_URL = "https://current-see-website-tdfranklin101.replit.app"
NEXT_PUBLIC_VERCEL_SITE_URL = "https://tc-s-network-main-gatewayv1.vercel.app"
TESTING_VITE_STRIPE_PUBLIC_KEY = "pk_test_51R82FbIiiOxB2ouydaiG0lZMqqxJPsnEqlPWqLajtSnhWHBAsp9VNQVz8b7A4oF5x3qy28hzYhGeFwfsPw1JHnXP00NmR1Ue2n"
TESTING_STRIPE_SECRET_KEY = "sk_test_51R82FbIiiOxB2ouyXUeTbzoTWFZ3UtG0NoWspXmxsOt1Xa5EHpl68n9Q80EqB5cPnYv16QUVRRzZNFtDyU9B3us600kQUMCGxQ"

[userenv.production]
NODE_ENV = "production"

[userenv.development]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node main.js"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000


