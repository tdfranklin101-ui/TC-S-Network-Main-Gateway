# Deployment optimization - exclude large directories
backup/
backup_*/
deployment_backups/
current_backup*/
pre_restore_*/
temp_extract/
logs/
*.log
*.pid

# Large asset directories (keep essential files only)
attached_assets/*.wav
attached_assets/*.mp4
attached_assets/*.mov
attached_assets/*.pdf

# Development files
node_modules/
.env
.env.local
test_*
debug_*

# User uploads and runtime data
uploads/
backups/
data/daily-brief.json
data/daily-brief-history.json
data/daily-brief-trends.json

# Keep essential files
!attached_assets/requirements*.txt
!public/
!main.js
!deploy-lightweight.js
!package.json
!replit.md
# Large video files (exceed GitHub 100MB limit)
public/videos/*.mp4
*.mp4

# Large video/media files (exceed GitHub 100MB limit)
public/videos/*.mp4
public/videos/*.mov
public/videos/*.avi
public/videos/*.mkv
attached_assets/*.mov
attached_assets/*.mp4
*.mov

# Backup snapshots — tracked files removed 2026-08-08; ignore future recurrences
*.backup
*-backup.html
*_backup.html
